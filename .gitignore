node_modules/
dist/
coverage/

# Deny-by-default: any local env file is ignored, and .env.example is the single
# exception because it is the documented template and carries no secrets. The
# narrow rules this replaces (.env, .env.local, .env*.local) did not cover a
# stray copy — .env.bak, .env.old, .env.apac — which would sit untracked but
# unignored, one `git add -A` from putting a real key in a public commit.
# Widened 2026-09-05, before that happened rather than after.
.env*
!.env.example

database/*.db
database/*.db-journal
database/*.db-wal
database/*.db-shm

# Claude Code: the checked-in half of `.claude/` (settings.json, agents/, skills/) is part of
# the repo — a fresh clone gets the same hooks, reviewers, and slash commands. Only
# machine-local state is ignored: personal setting overrides and tool lock/scratch files.
.claude/settings.local.json
.claude/*.lock
.claude/scheduled_tasks.lock
.codegraph

# Local embedding model weight cache (fastembed/transformers.js) — regenerable, can be large.
corpus/generated/.cache/
.cache/

# Corpus fact-verification report — a build artifact, not source. Regenerate in seconds
# with `pnpm corpus:generate --verify-only` (no model calls). Committing it would churn
# on every run via its timestamp.
corpus/.generation-report.json

# Eval harness working files. `.cache/` is per-question run and judgment results,
# which exist so a killed suite resumes instead of paying ~295 model calls again;
# `evals.db` is the isolated copy of the index the suite runs against, so eval
# traffic never lands in the trace store that §9 bakes into the deployed image.
# Both are regenerable. `results-latest.json` is NOT ignored — it is the source
# for the README's numbers and has to be reviewable in a diff, and neither is
# `results-pr-subset.json`, which is what `baseline.json` was recorded from.
# `results-partial.json` is: it is wherever a `--only`/`--category`/`--limit` run
# lands so that it cannot overwrite either of those, and a one-question suite is
# not a number anyone should be reviewing.
evals/.cache/
evals/results-partial.json

# UI (added in M2)
ui/.next/
ui/node_modules/

*.log
.DS_Store
