PORT=5000

# --- LLM provider (chat completions) ---
# Supported: gemini, groq, openrouter, ollama
# Gemini is the default: it produces markedly better citation density than the
# free Groq models, and citations are the point. Its free tier is the tighter of
# the two (~20 requests per window per model, ~4 calls per run), which the
# fallback below and the recorded-run replay both exist to absorb. See §11.3.
LLM_PROVIDER=gemini

# Ordered fallback chain, tried left to right when the primary is out of quota or
# unreachable. Free tiers are small, so a second provider is what keeps a demo
# alive — more retries only exhaust the same budget faster.
LLM_FALLBACK_PROVIDERS=groq

# Per-provider keys. Each provider prefers its own; LLM_API_KEY is a fallback for
# the provider named in LLM_PROVIDER only, never for a chain entry.
#
# GROQ_API_KEY does double duty since M6: the eval suite's LLM judge runs on the
# first configured fallback provider that is not the answerer, so with this setup
# Gemini answers and Groq judges. Without a second provider the judge shares the
# answerer's model, and `pnpm eval` says so in its output rather than implying an
# independence it does not have. See evals/README.md.
GEMINI_API_KEY=
GROQ_API_KEY=
# OPENROUTER_API_KEY=
# LLM_API_KEY=
# Override default models per tier (optional — see src/ai/llm/model-tiers.ts for defaults):
# LLM_MODEL_FAST=
# LLM_MODEL_DEFAULT=
# LLM_MODEL_DEEP=
# Retries per model call. Keep this low: every attempt counts against a free tier's
# quota, so retrying hard makes a 429 worse rather than better.
LLM_MAX_RETRIES=2

# --- Embedding provider ---
# Supported: gemini, ollama, precomputed.
#
# `precomputed` replays committed vectors instead of calling anything. It is a
# *build-time* provider — it is how the Docker image indexes the corpus with no key
# and no network — and a server started with it fails on the first question, because
# a question is not in the artifact. See EMBEDDING_VECTORS_PATH.
EMBEDDING_PROVIDER=gemini

# Optional for EMBEDDING_PROVIDER=gemini: a separate key (or comma-separated keys) for
# embeddings. Left empty, embeddings use GEMINI_API_KEY, then LLM_API_KEY when
# LLM_PROVIDER=gemini (AppConfigService.embeddingApiKeys).
EMBEDDING_API_KEY=

# These must describe the model the index was built with; the identity recorded in
# `index_meta` is checked at boot and a mismatch refuses to start rather than serving
# nonsense. An Ollama setup sets both (e.g. bge-m3 / 1024).
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# The vectors `precomputed` replays, written by `pnpm corpus:vectors`. Regenerate it
# whenever the corpus or CHUNK_SIZE changes — `pnpm corpus:vectors --check` says
# whether it is current, and costs nothing.
EMBEDDING_VECTORS_PATH=./corpus/index/embeddings.json

# --- Ollama (used when LLM_PROVIDER=ollama or EMBEDDING_PROVIDER=ollama) ---
OLLAMA_URL=http://localhost:11434
CHAT_MODEL=qwen3.5:9b

# --- Paths ---
DATABASE_PATH=./database/app.db
KNOWLEDGE_PATH=./corpus/generated
# Recorded runs replayed by POST /agent/ask?demo=1 — see `pnpm capture:runs`.
DEMO_RUNS_PATH=./fixtures/runs
# The authored question set, served to the UI as one-click examples by GET /agent/examples.
CORPUS_QUESTIONS_PATH=./corpus/questions.yaml

# --- Indexing ---
REINDEX_INTERVAL_MS=1800000

# --- Retrieval ---
TOP_K=5
# CHUNK_SIZE and CHUNK_OVERLAP are counted in WORDS, not characters — 700 words is
# roughly 4000 characters, so every document in the bundled corpus is a single chunk.
CHUNK_SIZE=700
CHUNK_OVERLAP=150
# Not enforced yet — retrieval returns top-K regardless. The value must be re-derived
# for the current embedding model before it can be wired up (see src/config/env.schema.ts).
RETRIEVAL_DISTANCE_THRESHOLD=0.9

# --- Agent ---
MAX_HOPS=2
MAX_FAN_OUT=5
AGENT_TIMEOUT_MS=60000

# --- Connectors (M5) ---
# Serve the MCP connectors from bundled synthetic data instead of connecting to
# anything real. Defaults to TRUE, which is the unusual choice and the deliberate one:
# the deployed instance runs this way (PLAN.md §9), and so does a fresh clone, so the
# setting that makes `pnpm start` demonstrate the connector needs no configuration.
#
# This is NOT the same thing as `?demo=1`. That query parameter replays a recorded run
# from fixtures/runs/ and makes no model calls at all. DEMO_MODE runs the entire live
# pipeline — triage, planning, retrieval, synthesis, memory — and only swaps where a
# connector's documents come from. It removes the need for *connector* credentials (a
# Gmail grant, a Slack token, a vault on disk); it does not remove the need for an LLM key.
DEMO_MODE=true

# MCP servers to connect to at boot, as a JSON array. Ignored — with a warning — while
# DEMO_MODE is on. Each entry launches a child process speaking MCP over stdio.
#
#   name       lower_snake_case; becomes the tool prefix (`obsidian_search_notes`) and
#              the evidenceId namespace, so it must not collide with a corpus tool
#   source     mail | chat | notes — which source this connector's results are filed as
#   allowTools REQUIRED allowlist. An MCP server advertises whatever it likes, including
#              writes and deletes; discovery is not consent. Nothing else is registered.
#   queryArg   optional — the parameter the search query goes in, when the server does
#              not call it `query`. Inferred from the tool's own schema when unset.
#
# Discovery happens once, at boot. A server that is down then is skipped for the life of
# the process, and the agent runs on the corpus tools alone rather than failing to start.
#
# MCP_SERVERS=[{"name":"obsidian","command":"npx","args":["-y","obsidian-mcp","/path/to/vault"],"source":"notes","allowTools":["search_notes"]}]

# The synthetic vault DEMO_MODE's Obsidian connector serves. Committed, so a clone has one.
MCP_DEMO_VAULT_PATH=./fixtures/mcp/vault

# Budget for connecting to a server, listing its tools, and each search afterwards.
# Generous because the first connection is the slow one — a server launched through `npx`
# may download the package before it says anything. A search is additionally bounded by
# the run's own deadline, which travels with the call as an AbortSignal.
MCP_TIMEOUT_MS=15000

# --- Memory ---
# Sessions kept by the LangGraph checkpointer that backs short-term memory. One turn
# writes ~7 checkpoints, each carrying the whole state — measured at ~77KB per turn,
# several times what the same conversation costs the trace store.
CHECKPOINT_RETENTION_SESSIONS=50

# Whether durable, cross-session memory runs at all (M4.2).
#
# **The deployed instance sets this to false**, and it is a §9 decision rather than a
# tuning knob: recall() searches all of memory_facts with no visitor filter, so on a
# public URL with no sign-in, cross-session is also cross-visitor. Scoping it to the
# session would delete the behaviour M4.2 exists to demonstrate, so the feature stays a
# local capability instead — like live connectors. Off means "not consulted", not
# "erased": flip it back and the store is where you left it.
LONG_TERM_MEMORY=true

# Long-term memory (M4.2). A candidate fact below the importance floor is dropped before
# it costs an embedding call; at or below the dedup distance it merges into the fact it
# restates instead of being inserted.
#
# MEMORY_DEDUP_DISTANCE is L2 and specific to the embedding model — 0.35 was derived for
# gemini-embedding-001 at 768d (docs/memory-dedup-threshold.md). Re-derive it if you change
# EMBEDDING_MODEL: too high merges two different preferences into one.
MEMORY_IMPORTANCE_FLOOR=0.5
MEMORY_DEDUP_DISTANCE=0.35
MEMORY_TOP_K=3
# Ceiling on how far a stored fact may sit from the question and still be recalled.
# Without one, recall took the k *nearest* however far away they were, so a store smaller
# than MEMORY_TOP_K handed every fact to every question — and because recall stamps what it
# returns, every run refreshed every fact and MEMORY_TTL_DAYS could never forget anything.
# L2 and model-specific, from the same nine pairs as MEMORY_DEDUP_DISTANCE: related-but-
# distinct facts sit at 0.405-0.463, unrelated text at 0.513-0.588. Weaker evidence than the
# dedup number (0.05 band, n=2 a side) — re-derive it in M6.
MEMORY_RECALL_DISTANCE=0.49
MEMORY_TTL_DAYS=30
MEMORY_CONSOLIDATION_INTERVAL_MS=21600000

# --- Public surface (PLAN.md §9) ---
# The rate limit on POST /agent/ask. The endpoint is unauthenticated and CORS is open
# by design, so this is the only control between a public URL and the day's model-call
# budget. Counted in questions, but budgeted in model calls: one question costs ~4
# against a free tier that answers ~20 per window. `?demo=1` replays are exempt — they
# make no model calls, and they are the fallback a visitor is pushed to when quota runs
# out. Set RATE_LIMIT_ENABLED=false for local development.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_MAX_ASKS=5

# How many reverse-proxy hops sit in front of the API (Express `trust proxy`).
# Load-bearing for the rate limit: at 0 behind a proxy every request looks like it came
# from the proxy, so the whole internet shares one bucket and one visitor locks out the
# rest. Too high is the mirror failure — X-Forwarded-For is client-supplied, so a caller
# can mint a fresh identity per request. 1 is right for a single platform proxy; use 0
# when the API is reached directly.
TRUST_PROXY_HOPS=1

# How long a recorded run is served in place of a live one after every provider has
# refused on quota (PLAN.md §9's degraded demo). A window rather than a probe, because
# finding out whether the quota returned costs the model call there is none of. A
# successful run closes it early.
QUOTA_FALLBACK_COOLDOWN_MS=600000

# --- Observability ---
# LangSmith tracing. Off by default so a clone runs with no extra account; the free
# personal tier is enough for this project. LangGraph reports its own nodes, and the
# OpenAI client is wrapped so each model call nests underneath the node that made it
# — without that wrapper a trace stops at the node and the LLM level is missing.
#
# Enabling this without a key fails at boot on purpose: LangSmith drops traces
# silently when it cannot authenticate, so the alternative symptom is an empty
# project noticed an hour later.
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
LANGSMITH_PROJECT=throughline
#
# LANGSMITH_ENDPOINT must match the region your LangSmith account lives in. A key
# issued in one region is rejected by every other region's endpoint with a bare
# 403 Forbidden on *all* authenticated calls, while unauthenticated ones still
# return 200 — so it looks exactly like a bad key, a missing plan or an unverified
# account, and the traces simply never appear. Check the region before you debug
# anything else.
#   US (default) https://api.smith.langchain.com
#   EU           https://eu.api.smith.langchain.com
#   APAC         https://apac.api.smith.langchain.com
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Runs and their spans are also stored locally, in the same sqlite file as the index
# (DATABASE_PATH above), and served by GET /agent/runs/:runId. Always on — it is what
# makes a run inspectable without an account.
#
# Oldest runs are pruned past this cap. There is deliberately no "unlimited": the
# in-memory store this replaced held 100 and emptied on restart, so making it durable
# without a bound would turn a buffer into a log that grows forever — and §9 bakes
# database/app.db into the deployed image. A run costs ~25-50KB, almost all of it the
# evidence text on evidence_added.
TRACE_RETENTION_RUNS=200
