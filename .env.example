PORT=5000

# --- LLM provider (chat completions) ---
# Supported: gemini, groq, openrouter, ollama
LLM_PROVIDER=gemini
LLM_API_KEY=

# Ordered fallback chain, tried left to right when the primary is out of quota or
# unreachable. Free tiers are small — one agent run costs ~4 model calls — so a
# second provider is what keeps a demo alive, not more retries.
# LLM_FALLBACK_PROVIDERS=groq,openrouter

# Per-provider keys. Each provider prefers its own; LLM_API_KEY is only used for
# the provider named in LLM_PROVIDER.
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# Override default models per tier (optional — see src/ai/llm/model-tiers.ts for defaults):
# LLM_MODEL_FAST=
# LLM_MODEL_DEFAULT=
# LLM_MODEL_DEEP=
# Retries per model call. Keep this low: every attempt counts against a free tier's
# quota, so retrying hard makes a 429 worse rather than better.
LLM_MAX_RETRIES=2

# --- Embedding provider ---
# Supported: gemini, ollama
EMBEDDING_PROVIDER=gemini
# Falls back to LLM_API_KEY when unset:
# EMBEDDING_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# --- Ollama (used when LLM_PROVIDER=ollama or EMBEDDING_PROVIDER=ollama) ---
OLLAMA_URL=http://localhost:11434
CHAT_MODEL=qwen3.5:9b

# --- Paths ---
DATABASE_PATH=./database/app.db
KNOWLEDGE_PATH=./corpus/generated
PROMPTS_PATH=./prompts

# --- Indexing ---
REINDEX_INTERVAL_MS=1800000

# --- Retrieval ---
TOP_K=5
# CHUNK_SIZE and CHUNK_OVERLAP are counted in WORDS, not characters — 700 words is
# roughly 4000 characters, so every document in the bundled corpus is a single chunk.
CHUNK_SIZE=700
CHUNK_OVERLAP=150
# Not enforced yet — retrieval returns top-K regardless. The value must be re-derived
# for the current embedding model before it can be wired up (see src/config/env.schema.ts).
RETRIEVAL_DISTANCE_THRESHOLD=0.9

# --- Agent ---
MAX_HOPS=2
MAX_FAN_OUT=5
AGENT_TIMEOUT_MS=60000
