PORT=5000

OLLAMA_URL=http://localhost:11434
CHAT_MODEL=qwen3.5:9b
# bge-m3 is multilingual. Run `ollama pull bge-m3` and, when switching from a
# different-dimension model, delete database/app.db* so the vec table recreates at the
# new size.
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024

DATABASE_PATH=./database/app.db
KNOWLEDGE_PATH=./knowledge/articles
PROMPTS_PATH=./prompts

REINDEX_INTERVAL_MS=1800000

TOP_K=5
CHUNK_SIZE=700
CHUNK_OVERLAP=150

RETRIEVAL_DISTANCE_THRESHOLD=0.9
