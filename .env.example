PORT=5000

# --- LLM provider (chat completions) ---
# Supported: gemini, groq, openrouter, ollama
# Gemini is the default: it produces markedly better citation density than the
# free Groq models, and citations are the point. Its free tier is the tighter of
# the two (~20 requests per window per model, ~4 calls per run), which the
# fallback below and the recorded-run replay both exist to absorb. See §11.3.
LLM_PROVIDER=gemini

# Ordered fallback chain, tried left to right when the primary is out of quota or
# unreachable. Free tiers are small, so a second provider is what keeps a demo
# alive — more retries only exhaust the same budget faster.
LLM_FALLBACK_PROVIDERS=groq

# Per-provider keys. Each provider prefers its own; LLM_API_KEY is a fallback for
# the provider named in LLM_PROVIDER only, never for a chain entry.
GEMINI_API_KEY=
GROQ_API_KEY=
# OPENROUTER_API_KEY=
# LLM_API_KEY=
# Override default models per tier (optional — see src/ai/llm/model-tiers.ts for defaults):
# LLM_MODEL_FAST=
# LLM_MODEL_DEFAULT=
# LLM_MODEL_DEEP=
# Retries per model call. Keep this low: every attempt counts against a free tier's
# quota, so retrying hard makes a 429 worse rather than better.
LLM_MAX_RETRIES=2

# --- Embedding provider ---
# Supported: gemini, ollama
EMBEDDING_PROVIDER=gemini
# Falls back to LLM_API_KEY when unset:
# EMBEDDING_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# --- Ollama (used when LLM_PROVIDER=ollama or EMBEDDING_PROVIDER=ollama) ---
OLLAMA_URL=http://localhost:11434
CHAT_MODEL=qwen3.5:9b

# --- Paths ---
DATABASE_PATH=./database/app.db
KNOWLEDGE_PATH=./corpus/generated
PROMPTS_PATH=./prompts
# Recorded runs replayed by POST /agent/ask?demo=1 — see `pnpm capture:runs`.
DEMO_RUNS_PATH=./fixtures/runs
# The authored question set, served to the UI as one-click examples by GET /agent/examples.
CORPUS_QUESTIONS_PATH=./corpus/questions.yaml

# --- Indexing ---
REINDEX_INTERVAL_MS=1800000

# --- Retrieval ---
TOP_K=5
# CHUNK_SIZE and CHUNK_OVERLAP are counted in WORDS, not characters — 700 words is
# roughly 4000 characters, so every document in the bundled corpus is a single chunk.
CHUNK_SIZE=700
CHUNK_OVERLAP=150
# Not enforced yet — retrieval returns top-K regardless. The value must be re-derived
# for the current embedding model before it can be wired up (see src/config/env.schema.ts).
RETRIEVAL_DISTANCE_THRESHOLD=0.9

# --- Agent ---
MAX_HOPS=2
MAX_FAN_OUT=5
AGENT_TIMEOUT_MS=60000

# --- Observability ---
# LangSmith tracing. Off by default so a clone runs with no extra account; the free
# personal tier is enough for this project. LangGraph reports its own nodes, and the
# OpenAI client is wrapped so each model call nests underneath the node that made it
# — without that wrapper a trace stops at the node and the LLM level is missing.
#
# Enabling this without a key fails at boot on purpose: LangSmith drops traces
# silently when it cannot authenticate, so the alternative symptom is an empty
# project noticed an hour later.
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
LANGSMITH_PROJECT=throughline
#
# LANGSMITH_ENDPOINT must match the region your LangSmith account lives in. A key
# issued in one region is rejected by every other region's endpoint with a bare
# 403 Forbidden on *all* authenticated calls, while unauthenticated ones still
# return 200 — so it looks exactly like a bad key, a missing plan or an unverified
# account, and the traces simply never appear. Check the region before you debug
# anything else.
#   US (default) https://api.smith.langchain.com
#   EU           https://eu.api.smith.langchain.com
#   APAC         https://apac.api.smith.langchain.com
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Runs and their spans are also stored locally, in the same sqlite file as the index
# (DATABASE_PATH above), and served by GET /agent/runs/:runId. Always on — it is what
# makes a run inspectable without an account.
#
# Oldest runs are pruned past this cap. There is deliberately no "unlimited": the
# in-memory store this replaced held 100 and emptied on restart, so making it durable
# without a bound would turn a buffer into a log that grows forever — and §9 bakes
# database/app.db into the deployed image. A run costs ~25-50KB, almost all of it the
# evidence text on evidence_added.
TRACE_RETENTION_RUNS=200
