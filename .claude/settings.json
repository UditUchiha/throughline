{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["scripts/hooks/guard-protected-files.mjs"],
            "timeout": 15,
            "statusMessage": "Checking protected paths"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["scripts/hooks/format-edited-file.mjs"],
            "timeout": 30,
            "statusMessage": "Formatting"
          },
          {
            "type": "command",
            "command": "node",
            "args": ["scripts/hooks/verify-corpus.mjs"],
            "timeout": 120,
            "statusMessage": "Verifying corpus answer key"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(pnpm build)",
      "Bash(pnpm lint)",
      "Bash(pnpm test:*)",
      "Bash(pnpm corpus:generate --verify-only)",
      "Bash(node scripts/inspect-index.mjs:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ]
  },
  "enabledMcpjsonServers": ["github"]
}
