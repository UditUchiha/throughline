{
  "name": "throughline",
  "version": "0.0.1",
  "description": "Agentic RAG over multi-source data \u2014 plans, retrieves across sources, and answers with citations.",
  "author": "",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,evals,scripts,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "corpus:generate": "node --env-file=.env -r ts-node/register scripts/corpus-generate.ts",
    "corpus:vectors": "node --env-file-if-exists=.env -r ts-node/register scripts/corpus-vectors.ts",
    "corpus:index": "node --env-file-if-exists=.env -r ts-node/register scripts/corpus-index.ts",
    "capture:runs": "node --env-file=.env -r ts-node/register scripts/capture-runs.ts",
    "scan:conflicts": "node --env-file-if-exists=.env -r ts-node/register scripts/scan-conflicts.ts",
    "eval": "node --env-file-if-exists=.env -r ts-node/register evals/run-evals.ts",
    "eval:compare": "node -r ts-node/register evals/compare.ts",
    "eval:sweep": "node -r ts-node/register evals/sweep.ts",
    "eval:judge-agreement": "node --env-file-if-exists=.env -r ts-node/register evals/judge-agreement.ts",
    "check:conventions": "node scripts/check-conventions.mjs"
  },
  "dependencies": {
    "@langchain/core": "^1.2.9",
    "@langchain/langgraph": "^1.4.13",
    "@langchain/langgraph-checkpoint-sqlite": "^1.0.4",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.5.0",
    "better-sqlite3": "^12.11.1",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.0",
    "langsmith": "^0.10.1",
    "nestjs-pino": "^4.6.1",
    "openai": "^7.4.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sqlite-vec": "^0.1.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/evals"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s",
      "evals/**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node"
  }
}
